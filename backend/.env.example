# APIMart API配置
APIMART_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 管理员密钥（用于管理后台）
ADMIN_KEY=your-admin-secret-key

# 服务配置
HOST=0.0.0.0
PORT=8000

# 图片保存路径
IMAGE_DIR=/var/www/image-gen-proxy/images

# 图片保留时间（小时）
IMAGE_RETENTION_HOURS=24

# 普通用户每日限额
DAILY_LIMIT=10

# CORS配置（前端域名）
CORS_ORIGINS=https://your-domain.com,http://localhost:5173

# JWT配置
JWT_SECRET=your-super-secret-key-change-this
JWT_EXPIRE_HOURS=72

# 数据库路径
DATABASE_PATH=/var/www/image-gen-proxy/users.db
